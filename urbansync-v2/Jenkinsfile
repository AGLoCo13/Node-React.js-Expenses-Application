// urbansync-v2/Jenkinsfile
// GitOps pipeline: build → push → update manifest tag → ArgoCD deploys.
// Jenkins builds Docker images, pushes them to localhost:5000, then rewrites
// the image tag in the k8s deployment manifests and commits back to dev-combined.
// ArgoCD watches dev-combined and syncs the cluster automatically.

pipeline {
    agent any

    triggers {
        // Poll GitHub every 2 minutes. The H spreads load across Jenkins jobs
        // so we don't hammer SCM at exactly :00 each minute.
        pollSCM('H/2 * * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY        = 'localhost:5000'
        BACKEND_IMAGE   = "${REGISTRY}/urbansync-backend"
        FRONTEND_IMAGE  = "${REGISTRY}/urbansync-frontend"
        ANNOTATOR_IMAGE = "${REGISTRY}/urbansync-receipt-annotator"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                    def commitMsg = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    if (commitMsg.contains('[skip ci]')) {
                        currentBuild.result = 'NOT_BUILT'
                    }
                }
                echo "Tagging images as :${env.GIT_SHA}"
            }
        }

        // Each branch only runs when its own directory actually changed, so an
        // unrelated commit (e.g. backend-only) doesn't rebuild/repush/redeploy
        // the other two images and churn pods that didn't need to move.
        stage('Build & Push') {
            when { expression { currentBuild.result == null } }
            parallel {
                stage('Backend') {
                    when { changeset "urbansync-v2/backend/**"; beforeAgent true }
                    steps {
                        dir('urbansync-v2/backend') {
                            sh '''
                                docker build \
                                    -t "${BACKEND_IMAGE}:${GIT_SHA}" \
                                    -t "${BACKEND_IMAGE}:latest" \
                                    .
                                docker push "${BACKEND_IMAGE}:${GIT_SHA}"
                                docker push "${BACKEND_IMAGE}:latest"
                            '''
                        }
                        script { env.BACKEND_CHANGED = 'true' }
                    }
                }
                stage('Frontend') {
                    when { changeset "urbansync-v2/frontend/**"; beforeAgent true }
                    steps {
                        dir('urbansync-v2/frontend') {
                            sh '''
                                docker build \
                                    -t "${FRONTEND_IMAGE}:${GIT_SHA}" \
                                    -t "${FRONTEND_IMAGE}:latest" \
                                    .
                                docker push "${FRONTEND_IMAGE}:${GIT_SHA}"
                                docker push "${FRONTEND_IMAGE}:latest"
                            '''
                        }
                        script { env.FRONTEND_CHANGED = 'true' }
                    }
                }
                stage('Receipt Annotator') {
                    when { changeset "urbansync-v2/knative/receipt-annotator/**"; beforeAgent true }
                    steps {
                        dir('urbansync-v2/knative/receipt-annotator') {
                            sh '''
                                docker build \
                                    -t "${ANNOTATOR_IMAGE}:${GIT_SHA}" \
                                    -t "${ANNOTATOR_IMAGE}:latest" \
                                    .
                                docker push "${ANNOTATOR_IMAGE}:${GIT_SHA}"
                                docker push "${ANNOTATOR_IMAGE}:latest"
                            '''
                        }
                        script { env.ANNOTATOR_CHANGED = 'true' }
                    }
                }
            }
        }

        stage('Update manifests') {
            when { expression { currentBuild.result == null } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-creds',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PAT'
                )]) {
                    sh '''
                        git config user.email "jenkins@urbansync.local"
                        git config user.name  "Jenkins CI"

                        if [ "${BACKEND_CHANGED}" = "true" ]; then
                            sed -i "s|localhost:5000/urbansync-backend:.*|localhost:5000/urbansync-backend:${GIT_SHA}|g" \
                                urbansync-v2/k8s/base/backend/deployment.yaml
                            git add urbansync-v2/k8s/base/backend/deployment.yaml
                        fi
                        if [ "${FRONTEND_CHANGED}" = "true" ]; then
                            sed -i "s|localhost:5000/urbansync-frontend:.*|localhost:5000/urbansync-frontend:${GIT_SHA}|g" \
                                urbansync-v2/k8s/base/frontend/deployment.yaml
                            git add urbansync-v2/k8s/base/frontend/deployment.yaml
                        fi
                        if [ "${ANNOTATOR_CHANGED}" = "true" ]; then
                            sed -i "s|localhost:5000/urbansync-receipt-annotator:.*|localhost:5000/urbansync-receipt-annotator:${GIT_SHA}|g" \
                                urbansync-v2/k8s/base/knative/kservice.yaml
                            git add urbansync-v2/k8s/base/knative/kservice.yaml
                        fi

                        if git diff --cached --quiet; then
                            echo "No manifest changes — already up to date."
                        else
                            git commit -m "ci: update image tags to ${GIT_SHA} [skip ci]"
                            git push \
                                "https://${GIT_USER}:${GIT_PAT}@github.com/AGLoCo13/Node-React.js-Expenses-Application.git" \
                                HEAD:dev-combined
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Build complete (only changed components were rebuilt). Manifests updated where needed — ArgoCD will sync the cluster."
        }
        always {
            cleanWs()
        }
    }
}
