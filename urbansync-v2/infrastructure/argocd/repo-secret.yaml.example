# =============================================================================
# repo-secret.yaml.example — ArgoCD Repository Credential Secret Template
# =============================================================================
# Instructions:
#   1. Copy: cp repo-secret.yaml.example repo-secret.yaml
#   2. Fill in real values.
#   3. Never commit repo-secret.yaml — it is gitignored.
#   4. Ansible writes this file automatically from vars/secrets.yml.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: urbansync-repo-credentials
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: https://github.com/AGLoCo13/Node-React.js-Expenses-Application.git
  username: your_github_username_here
  password: ghp_your_token_here
