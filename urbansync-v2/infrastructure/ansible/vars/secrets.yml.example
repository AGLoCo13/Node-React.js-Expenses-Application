# =============================================================================
# secrets.yml.example — Template for Ansible secrets
# =============================================================================
# Instructions:
#   1. Copy this file: cp secrets.yml.example secrets.yml
#   2. Fill in the real values below.
#   3. Never commit secrets.yml — it is gitignored.
# =============================================================================

# GitHub Personal Access Token with Contents: Read permission.
# Generate at: https://github.com/settings/tokens
github_pat: "ghp_your_token_here"

# Jenkins admin account password — set to whatever you want.
jenkins_admin_password: "your_password_here"

# GitHub username 
github_username: "your_username_here"
