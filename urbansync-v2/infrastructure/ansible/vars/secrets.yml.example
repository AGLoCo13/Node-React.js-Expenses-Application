# =============================================================================
# secrets.yml.example — Template for Ansible secrets (SOPS + age)
# =============================================================================
#
# This file is the template for secrets.enc.yml — the single encrypted file
# that contains every secret the project needs.
#
# WORKFLOW:
#   1. Install tools (one-time):
#        winget install FiloSottile.age
#        winget install mozilla.sops
#        ansible-galaxy collection install -r requirements.yml
#
#   2. Get the age private key from a teammate and save to:
#        Windows: %APPDATA%\sops\age\keys.txt
#        Linux:   ~/.config/sops/age/keys.txt
#
#   3. To create secrets.enc.yml from scratch (key holder only):
#        cp secrets.yml.example secrets.yml
#        # Fill in real values below, then encrypt:
#        sops --encrypt secrets.yml > secrets.enc.yml
#        # Commit secrets.enc.yml — it is safe in Git
#        # Delete secrets.yml (never commit it)
#
#   4. To run the playbook (everyone with the key):
#        ansible-playbook -i inventory.ini deploy.yml
#        (Ansible auto-decrypts secrets.enc.yml via community.sops)
#
#   5. To edit the encrypted file later:
#        sops secrets.enc.yml   (opens in $EDITOR, re-encrypts on save)
# =============================================================================

# ---------------------------------------------------------------------------
# GitHub — required for Jenkins CI/CD and ArgoCD repo access
# Generate a PAT at: https://github.com/settings/tokens
# Required scopes: Contents (read), Webhooks (read) for the repo
# ---------------------------------------------------------------------------
github_pat: "ghp_your_token_here"
github_username: "your_github_username_here"

# ---------------------------------------------------------------------------
# Jenkins admin account password — set to whatever you want
# ---------------------------------------------------------------------------
jenkins_admin_password: "your_password_here"

# ---------------------------------------------------------------------------
# Azure — only needed for prod deployment
# azure_tenant_id: run  az account show --query tenantId -o tsv  on the Azure VM
# ---------------------------------------------------------------------------
azure_keyvault_name: "urbansync-kv"
azure_tenant_id: "your_tenant_id_here"

# ---------------------------------------------------------------------------
# Application secrets — defaults below match the local docker-compose values.
# Safe to leave as-is for local dev; change for prod.
# ---------------------------------------------------------------------------
mongo_user: "admin"
mongo_pass: "admin123"
mongo_uri: "mongodb://admin:admin123@mongodb:27017/commons-db?authSource=admin"
rabbitmq_user: "admin"
rabbitmq_pass: "admin123"
rabbitmq_url: "amqp://admin:admin123@rabbitmq:5672"
minio_access_key: "admin"
minio_secret_key: "password123"
jwt_secret: "your-secret-key"

# Google Gemini API key — get at: https://aistudio.google.com/app/apikey
gemini_api_key: "REPLACE_WITH_REAL_KEY"
