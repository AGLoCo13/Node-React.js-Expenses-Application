# =============================================================================
# terraform.tfvars.example — Template αρχείο μεταβλητών
# =============================================================================
# ΟΔΗΓΙΕΣ:
#   1. Αντέγραψε αυτό το αρχείο ως "terraform.tfvars":
#         cp terraform.tfvars.example terraform.tfvars
#   2. Συμπλήρωσε τις τιμές σου παρακάτω.
#   3. ΜΗΝ κάνεις commit το terraform.tfvars — είναι ήδη στο .gitignore!
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Region
# Επίλεξε την περιοχή που θέλεις (π.χ. "West Europe", "North Europe")
# -----------------------------------------------------------------------------
location = "West Europe"

# -----------------------------------------------------------------------------
# Resource Group Name
# Το όνομα του Resource Group στο Azure.
# Όλοι οι υπόλοιποι πόροι ονομάζονται με βάση αυτό (urbansync-rg-vm κ.λπ.)
# -----------------------------------------------------------------------------
resource_group_name = "urbansync-rg"

# -----------------------------------------------------------------------------
# Key Vault Name  (ΥΠΟΧΡΕΩΤΙΚΟ — δεν έχει default)
# Πρέπει να είναι ΜΟΝΑΔΙΚΟ ΠΑΓΚΟΣΜΙΩΣ, 3-24 χαρακτήρες.
# Προσοχή: ένα διαγραμμένο Key Vault κρατάει το όνομά του δεσμευμένο (soft
# delete), οπότε μη χρησιμοποιήσεις όνομα που υπήρξε στο παρελθόν.
# Πρότεινε κάτι σαν "urbansync-kv-ab12".
#
# Η ίδια τιμή πρέπει να μπει και σε:
#   - k8s/overlays/prod/secret-provider-class.yaml  (keyvaultName)
#   - infrastructure/ansible/vars/secrets.enc.yml   (azure_keyvault_name)
# -----------------------------------------------------------------------------
keyvault_name = "urbansync-kv-CHANGEME"

# -----------------------------------------------------------------------------
# Admin Username
# Το username για σύνδεση στο VM μέσω SSH
# -----------------------------------------------------------------------------
admin_username = "azureuser"

# -----------------------------------------------------------------------------
# SSH Public Key
# Επικόλλησε εδώ το περιεχόμενο του δημόσιου κλειδιού σου (~/.ssh/id_rsa.pub)
# Παράδειγμα: ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAB... user@hostname
# -----------------------------------------------------------------------------
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-email@example.com"
