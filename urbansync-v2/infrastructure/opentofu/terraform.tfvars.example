# =============================================================================
# terraform.tfvars.example — Template αρχείο μεταβλητών
# =============================================================================
# ΟΔΗΓΙΕΣ:
#   1. Αντέγραψε αυτό το αρχείο ως "terraform.tfvars":
#         cp terraform.tfvars.example terraform.tfvars
#   2. Συμπλήρωσε τις τιμές σου παρακάτω.
#   3. ΜΗΝ κάνεις commit το terraform.tfvars — είναι ήδη στο .gitignore!
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Region
# Επίλεξε την περιοχή που θέλεις (π.χ. "West Europe", "North Europe")
# -----------------------------------------------------------------------------
location = "West Europe"

# -----------------------------------------------------------------------------
# Resource Group Name
# Το όνομα του Resource Group στο Azure
# -----------------------------------------------------------------------------
resource_group_name = "gas-receipts-rg"

# -----------------------------------------------------------------------------
# Admin Username
# Το username για σύνδεση στο VM μέσω SSH
# -----------------------------------------------------------------------------
admin_username = "azureuser"

# -----------------------------------------------------------------------------
# SSH Public Key
# Επικόλλησε εδώ το περιεχόμενο του δημόσιου κλειδιού σου (~/.ssh/id_rsa.pub)
# Παράδειγμα: ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAB... user@hostname
# -----------------------------------------------------------------------------
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-email@example.com"
