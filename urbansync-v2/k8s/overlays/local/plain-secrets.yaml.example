# =============================================================================
# plain-secrets.yaml.example — Template for generating the local SealedSecret
# =============================================================================
# Instructions:
#   1. Copy: cp plain-secrets.yaml.example plain-secrets.yaml
#   2. Fill in gemini-api-key (or leave placeholder for a test deployment)
#   3. Run kubeseal to encrypt:
#        kubeseal --format yaml --cert pub-cert.pem \
#          < plain-secrets.yaml > sealed-secrets.yaml
#   4. Commit sealed-secrets.yaml — it is safe in Git (encrypted)
#   5. Delete plain-secrets.yaml — never commit it
#
# Re-seal if the Sealed Secrets controller is reinstalled (new key pair).
# Back up the controller key: kubectl get secret -n kube-system -l sealedsecrets.bitnami.com/sealed-secrets-key -o yaml
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: urbansync-secrets
  namespace: urbansync
type: Opaque
stringData:
  mongo-user: admin
  mongo-pass: admin123
  mongo-uri: mongodb://admin:admin123@mongodb:27017/commons-db?authSource=admin
  rabbitmq-user: admin
  rabbitmq-pass: admin123
  rabbitmq-url: amqp://admin:admin123@rabbitmq:5672
  minio-access-key: admin
  minio-secret-key: password123
  jwt-secret: your-secret-key
  gemini-api-key: REPLACE_WITH_REAL_KEY
