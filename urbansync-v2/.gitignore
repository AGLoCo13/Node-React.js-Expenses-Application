# ── Node.js ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ─────────────────────────────────────────────────────────
frontend/build/

# ── Environment files (NEVER commit secrets) ─────────────────────────────
.env
.env.local
.env.*.local
backend/.env

# ── Kubernetes secrets ────────────────────────────────────────────────────
k8s/secrets.yaml

# ── IaC secrets ───────────────────────────────────────────────────────────
infrastructure/opentofu/terraform.tfvars
infrastructure/opentofu/.terraform/
infrastructure/opentofu/*.tfstate
infrastructure/opentofu/tfplan
infrastructure/opentofu/*.tfstate.backup
infrastructure/opentofu/.terraform.lock.hcl

# ── Ansible secrets ───────────────────────────────────────────────────────
infrastructure/ansible/group_vars/all/vault.yml
infrastructure/ansible/*.retry

# ── OS & IDE ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo
*.html

# ── Docker ────────────────────────────────────────────────────────────────
*.log
