# ── urbansync-v2/frontend/.dockerignore ──────────────────────────────────────
# Prevents local build artifacts and host node_modules from polluting the
# Docker build context. This keeps the context small and the build reproducible.

# Local dependency installations — Docker installs fresh inside the container
node_modules

# Previous local build output — Docker builds its own via `npm run build`
build

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files themselves (no need to send to daemon)
Dockerfile
.dockerignore

# Version control
.git
.gitignore

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local
